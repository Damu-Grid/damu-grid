# Names only. Copy to .env locally. Never commit real values.
# See docs/GITHUB_RULES.md and AGENTS.md.

# App
DAMU_ENV=development
LOG_LEVEL=info
AS_OF_DATE=2026-10-31
TIMEZONE=Africa/Nairobi

# API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/processed/damu_grid.sqlite
ACTION_DATABASE_URL=sqlite:///./data/processed/actions.sqlite
RESERVATION_LEASE_MINUTES=30

# Auth for the demo (test logins for judges; not production security)
DEMO_COORDINATOR_USER=
DEMO_COORDINATOR_PASSWORD=
DEMO_SENDER_USER=
DEMO_SENDER_PASSWORD=
DEMO_RECEIVER_USER=
DEMO_RECEIVER_PASSWORD=

# LLM explanations (live provider used in the demo; disabled by default in code).
LLM_ENABLED=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Africa's Talking SMS sandbox (optional Tier 2 simulation). Username is typically "sandbox".
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_FROM=
SMS_SIMULATION_ONLY=true

# Frontend (put these in frontend/.env.local; see frontend/README.md)
# prototype = backend/prototype.py, spec = docs/API_SPEC.md
NEXT_PUBLIC_BACKEND=prototype
# Next.js relays /api/backend/* here, so the backend needs no CORS
BACKEND_URL=http://127.0.0.1:8000
# Leave unset to use the relay; a full URL calls the backend directly
NEXT_PUBLIC_API_BASE_URL=
